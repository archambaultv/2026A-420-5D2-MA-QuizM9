# Copier en .env (le fichier .env n'est pas versionné : il contient des secrets).

# OWNER : le compte GitHub qui publie les images, en minuscules.
#         archambaultv pour les images du cours, ou votre compte.
# TAG   : latest, ou un tag sha-xxxxxxx pour épingler une version.
OWNER=archambaultv
TAG=latest

# Le nom de la machine, tel que tapé dans le navigateur.
#   Sur votre poste : quizm9.localhost
#   Sur une VM      : son nom DNS, par exemple quizm9-alice.canadacentral.cloudapp.azure.com
DOMAIN=quizm9.localhost

# Le mot de passe de la base, choisi ici une fois pour toutes : il crée
# l'utilisateur au premier démarrage et sert ensuite à l'API.
POSTGRES_PASSWORD=changez-moi

# La clé qui signe les cookies de session : une longue chaîne aléatoire.
# Obligatoire : l'API refuse de démarrer sans elle.
SESSION_SECRET=changez-moi-aussi

# L'application OAuth GitHub de CETTE machine. Son URL de rappel :
#   https://DOMAIN/api/auth/callback
# Facultatif : sans elle, la connexion alice / alice fonctionne toujours.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
